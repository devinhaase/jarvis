# Secrets — never commit these
.env
credentials.json
token.json
devices.json
# Phase 8 — any downloaded API key/secret file dropped at the project root before being
# read into an encrypted data/*.enc store (e.g. OPNsense's own "System > Access > API Keys"
# download). Real near-miss: an OPNsense key file sat here un-ignored for one session before
# this pattern was added — caught before a git add ever ran, not after.
*apikey*.txt
*api_key*.txt

# Runtime data — conversation history, memory, generated payloads, voice models, backups
data/
backups/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
venv/
env/
.venv/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log

# Downloaded binary, not project content — re-fetched via caddy/README.md, not committed
caddy/caddy.exe

# mkcert-issued LAN cert/key (Remote Access rework) — machine-specific, regenerated locally
# per REMOTE_ACCESS.md's "Local HTTPS on the LAN" section, never committed.
caddy/lan_cert.pem
caddy/lan_key.pem

# Local tool config, not project content
.claude/

# Stray artifacts from running test_harness.py (draft_local_note writes these fresh each run)
/meeting.md
/email_summary.md

# Android app (Part 2 of the native-app work) — build outputs and machine-specific config,
# same reasoning as desktop_app/.venv above.
android_app/local.properties
android_app/.gradle/
android_app/build/
android_app/app/build/
android_app/.idea/
android_app/*.iml
android_app/app/*.iml
android_app/captures/
android_app/.cxx/
android_app/keystore.properties
android_app/*.jks
android_app/*.keystore
